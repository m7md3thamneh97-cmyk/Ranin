# Documentation only. Do not commit a populated secret file.
PORT=8080
RANEEN_DATA_DIR=/data
# Hosting supplies RENDER_EXTERNAL_URL or RAILWAY_PUBLIC_DOMAIN.
# Optional override, only for a domain actually assigned to this service:
# RANEEN_PUBLIC_ORIGIN=https://YOUR-ACTUAL-ASSIGNED-DOMAIN
# Generate and save privately; no default secret is supplied:
RANEEN_ADMIN_TOKEN=
# Attach a volume at /data; Railway supplies RAILWAY_VOLUME_MOUNT_PATH.

# Enrollment and new learning provider calls require deliberate activation.
RANEEN_VOICE_ENROLLMENT_ENABLED=0
RANEEN_LEARNING_STUDIO_ENABLED=0
RANEEN_PLATFORM_HOME=1
RANEEN_LEARNING_PROVIDER=local_rules
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
VAPI_API_KEY=
VAPI_PUBLIC_API_KEY=
RANEEN_VAPI_WEBHOOK_SECRET=
# Existing provider defaults are documented in docs/GATE_B_OPERATOR.md.
# Never paste a populated version of this file into Git or chat.
