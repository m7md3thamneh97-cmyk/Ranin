# Documentation only. Do not commit a populated secret file.
PORT=8080
RANEEN_DATA_DIR=/data
# Generate a public domain in Railway. RAILWAY_PUBLIC_DOMAIN is supplied by Railway.
# Optional override, only for a domain actually assigned to this service:
# RANEEN_PUBLIC_ORIGIN=https://YOUR-ACTUAL-ASSIGNED-DOMAIN
# Generate and save privately; no default secret is supplied:
RANEEN_ADMIN_TOKEN=
# Single-conversation voice creation. Provider secrets remain in hosting settings.
RANEEN_BECOMING_ENABLED=0
RANEEN_BECOMING_MIN_SPEECH_SECONDS=30
RANEEN_BECOMING_RETENTION_DAYS=7
# Existing Raneen/Sura assistant, read as a template; the assistant is never modified.
RANEEN_VAPI_TEMPLATE_ID=
# Optional voice model used for both direct synthesis and the Vapi clone runtime.
RANEEN_VAPI_VOICE_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# OPENAI_API_KEY, ELEVENLABS_API_KEY and VAPI_API_KEY are private server credentials.
# Attach a volume at /data; Railway supplies RAILWAY_VOLUME_MOUNT_PATH.
